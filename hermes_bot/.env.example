# HERMES Bot Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# Telegram (already setup)
TG_TOKEN=8894045436:AAHuFSPIrF--BTxc84t2bRg-ZSp3QcdlhZs
TG_CHAT_ID=989563434

# GitHub Personal Access Token (REQUIRED for git sync)
# Create at: https://github.com/settings/tokens?type=beta
# Permissions needed: Contents (Read and Write) for repo fagriyawan/fagriyawan.github.io
GITHUB_TOKEN=ghp_your_token_here

# Repo settings (defaults are fine)
GITHUB_REPO=fagriyawan/fagriyawan.github.io
GITHUB_BRANCH=hermes-trading-bot

# Polling interval (in seconds). 600 = 10 minutes
POLL_INTERVAL_SEC=600

# UTC hour for daily report (0 = 00:00 UTC = 07:00 WIB)
DAILY_REPORT_HOUR_UTC=0
